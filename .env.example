# Velma Transcribe (engines/velma.py) - API key from the Modulate dashboard: https://www.modulate.ai
VELMA_API_KEY=

# Deepgram (engines/deepgram.py) - API key from the Deepgram console: https://console.deepgram.com
DEEPGRAM_API_KEY=

# AssemblyAI (engines/assemblyai.py) - API key from the AssemblyAI dashboard: https://www.assemblyai.com/app
ASSEMBLYAI_API_KEY=

# Whisper large-v3 via Hugging Face Inference Providers (the WhisperHF engine in engines/) - user access token from https://huggingface.co/settings/tokens
HF_TOKEN=

# Path to a built whisper.cpp checkout, used by the local whisper_cpp_* engines (engines/whisper_cpp_local.py)
WHISPER_CPP_DIR=

# Google Chirp 3 and Microsoft MAI-Transcribe 2 via OpenRouter (engines/openrouter_stt.py) - API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
